---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  loadCourseManifests,
  resolveCourseResourceGroups,
  type CourseManifestRecord,
} from "../../../data/course-manifests";
import { buildCourseSchedule } from "../../../data/course-schedule";
import { withBasePath } from "../../../data/site";

type EditionLink = Pick<CourseManifestRecord, "academicYear" | "href">;

type Props = {
  editions: EditionLink[];
  record: CourseManifestRecord;
};

export const getStaticPaths = (async () => {
  const records = (await loadCourseManifests()).filter(
    (record) => record.courseSlug === "aos",
  );
  const editions = records.map(({ academicYear, href }) => ({
    academicYear,
    href,
  }));

  return records.map((record) => ({
    params: { academicYear: record.academicYear },
    props: { editions, record },
  }));
}) satisfies GetStaticPaths;

const { editions, record } = Astro.props as Props;
const { manifest } = record;
const peopleById = new Map(manifest.people.map((person) => [person.id, person]));
const artifactsById = new Map(
  manifest.artifacts.map((artifact) => [artifact.id, artifact]),
);
const externalLinksById = new Map(
  manifest.external_links.map((link) => [link.id, link]),
);
const staff = manifest.course.staff.map(({ person, role }) => ({
  person: peopleById.get(person)!,
  role,
}));
const announcements = [...manifest.announcements].sort(
  (left, right) =>
    Date.parse(right.published_at) - Date.parse(left.published_at),
);
const schedule = buildCourseSchedule(manifest);
const resourceGroups = resolveCourseResourceGroups(manifest);
const announcementDate = new Intl.DateTimeFormat(manifest.site.locale, {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: manifest.site.timezone,
});
---

<BaseLayout
  title={`${manifest.site.short_title} ${manifest.course.academic_year}`}
  description={manifest.site.summary}
>
  <main class="page-shell course-edition">
    <section class="page-hero course-edition__hero">
      <p class="eyebrow">
        Teaching · {manifest.site.short_title} · {manifest.course.academic_year}
      </p>
      <h1>
        <span class="section-marker" aria-hidden="true">§1</span>{manifest.site.title}
      </h1>
      <p class="lede">{manifest.site.summary}</p>
      <dl class="course-facts">
        <div>
          <dt>Edition</dt>
          <dd>
            <nav class="course-edition-nav" aria-label="AOS course editions">
              {
                editions.map((edition) => (
                  <a
                    href={withBasePath(edition.href)}
                    aria-current={
                      edition.academicYear === record.academicYear ? "page" : undefined
                    }
                  >
                    {edition.academicYear.replace("-", "/")}
                  </a>
                ))
              }
            </nav>
          </dd>
        </div>
        <div>
          <dt>Institution</dt>
          <dd>{manifest.course.institution}</dd>
        </div>
        <div>
          <dt>Staff</dt>
          <dd>
            {
              staff.map(({ person, role }) => (
                <span>
                  <a href={`mailto:${person.email}`}>{person.name}</a>
                  <small>{role.replaceAll("-", " ")}</small>
                </span>
              ))
            }
          </dd>
        </div>
        {
          schedule.slots.length > 0 && (
            <div>
              <dt>Weekly classes</dt>
              <dd>
                {schedule.slots.map((slot) => (
                  <span>
                    {slot.weekday} {slot.time}
                    {slot.location && <small>Room {slot.location}</small>}
                  </span>
                ))}
              </dd>
            </div>
          )
        }
        {
          schedule.next && (
            <div class="course-facts__next">
              <dt>Next class</dt>
              <dd>
                <a href={`#${schedule.next.event.id}`}>
                  {schedule.next.date} · {schedule.next.time} · {schedule.next.event.location}
                </a>
                <span>{schedule.next.event.topic}</span>
              </dd>
            </div>
          )
        }
      </dl>
    </section>

    <div class="course-board">
      {
        announcements.length > 0 && (
          <section
            class="course-panel course-board__updates"
            aria-labelledby="course-announcements"
          >
            <h2 class="course-panel__title" id="course-announcements">
              Announcements
            </h2>
            <div class="course-announcements">
              {announcements.map((announcement, index) => (
                <details class="course-announcement" open={index === 0}>
                  <summary>
                    <time datetime={announcement.published_at}>
                      {announcementDate.format(new Date(announcement.published_at))}
                    </time>
                    <span>{announcement.title}</span>
                  </summary>
                  <p>{announcement.body}</p>
                  {(announcement.artifacts.length > 0 ||
                    (announcement.external_links ?? []).length > 0) && (
                    <ul class="course-inline-links">
                      {announcement.artifacts.map((artifactId) => {
                        const artifact = artifactsById.get(artifactId)!;
                        return <li><a href={artifact.href}>{artifact.title}</a></li>;
                      })}
                      {(announcement.external_links ?? []).map((linkId) => {
                        const link = externalLinksById.get(linkId)!;
                        return <li><a href={link.href}>{link.title}</a></li>;
                      })}
                    </ul>
                  )}
                </details>
              ))}
            </div>
          </section>
        )
      }

      <section
        class="course-panel course-board__schedule"
        aria-labelledby="course-schedule"
      >
        <div class="course-panel__header">
          <h2 class="course-panel__title" id="course-schedule">
            <span class="section-marker" aria-hidden="true">§2</span>Schedule
          </h2>
          {
            schedule.statusCounts.length > 0 && (
              <ul class="course-status-counts" aria-label="Classes by status">
                {schedule.statusCounts.map(({ status, count }) => (
                  <li>
                    <span class={`status-dot status-dot--${status}`} aria-hidden="true" />
                    {count} {status}
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        <p class="course-schedule-notice">{manifest.schedule.notice}</p>
        {
          schedule.months.length > 0 ? (
            <table class="course-timetable">
              <caption class="visually-hidden">
                {manifest.site.short_title} {manifest.course.academic_year} schedule
              </caption>
              <thead>
                <tr>
                  <th scope="col">Date</th>
                  <th scope="col">Type</th>
                  <th scope="col">Topic</th>
                  <th scope="col">Room</th>
                  <th scope="col">Materials</th>
                </tr>
              </thead>
              {schedule.months.map((month) => (
                <tbody>
                  <tr class="course-timetable__month">
                    <th scope="rowgroup" colspan="5">{month.label}</th>
                  </tr>
                  {month.rows.map((row) => {
                    const { event } = row;
                    const meta = [
                      ...(row.regularTime ? [] : [row.time]),
                      ...row.staff,
                    ];
                    return (
                      <tr
                        id={event.id}
                        class:list={[
                          "course-row",
                          `course-row--${event.status}`,
                          { "course-row--next": row.next },
                        ]}
                      >
                        <td class="course-row__date">
                          <span
                            class={`status-dot status-dot--${event.status}`}
                            title={event.status}
                            aria-hidden="true"
                          />
                          <time datetime={event.start}>
                            {row.weekday} <strong>{row.day}</strong>
                          </time>
                          <span class="visually-hidden">, {event.status}</span>
                        </td>
                        <td class="course-row__kind">{row.kind}</td>
                        <td class="course-row__topic">
                          {row.next && <span class="course-badge">Next</span>}
                          {event.topic}
                          {(meta.length > 0 || row.links.length > 0) && (
                            <span class="course-row__meta">
                              {meta.map((item) => <span>{item}</span>)}
                              {row.links.map((link) => (
                                <a href={link.href}>{link.title}</a>
                              ))}
                            </span>
                          )}
                        </td>
                        <td class="course-row__room">
                          {event.status === "cancelled" ? "—" : event.location}
                        </td>
                        <td class="course-row__materials">
                          {row.materials.map((material) => (
                            <a
                              class="course-chip"
                              href={material.href}
                              download={material.download}
                              title={material.title}
                              aria-label={`${material.download ? "Download" : "Open"} ${material.title}`}
                            >
                              {material.label}
                            </a>
                          ))}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              ))}
            </table>
          ) : (
            <p class="course-empty">The detailed schedule has not been published yet.</p>
          )
        }
      </section>

      <section
        class="course-panel course-board__resources"
        aria-labelledby="course-resources"
      >
        <div class="course-panel__header">
          <h2 class="course-panel__title" id="course-resources">
            <span class="section-marker" aria-hidden="true">§3</span>Resources
          </h2>
        </div>
        <div class="course-resource-groups">
          {
            resourceGroups.map((group) => (
              <section class="course-resource-group" aria-labelledby={`resources-${group.id}`}>
                <h3 id={`resources-${group.id}`}>{group.title}</h3>
                <ul class="course-link-list">
                  {group.artifacts.map((artifact) => (
                    <li>
                      <a href={artifact.href}>{artifact.title}</a>
                      <span>
                        {artifact.kind === "collection"
                          ? "Folder"
                          : artifact.media_type === "application/pdf"
                            ? "PDF"
                            : "File"}
                      </span>
                    </li>
                  ))}
                  {group.external_links.map((link) => (
                    <li>
                      <a href={link.href}>{link.title}</a>
                      {link.description && <span>{link.description}</span>}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
