---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  publicCv
} from "../../data/public-content";
import { loadCourseManifests } from "../../data/course-manifests";
import { withBasePath } from "../../data/site";

type Course = (typeof publicCv.teaching.courses)[number];

const courseRegistry = [...publicCv.teaching.courses].sort(
  (left, right) => right.aaEnd - left.aaEnd || right.aaInit - left.aaInit
);
const leadInstructorCourses = courseRegistry.filter(
  (course) => course.position.trim().toLowerCase() === "titolare",
);
const teachingAssistantCourses = courseRegistry.filter(
  (course) =>
    course.position.trim().toLowerCase() === "esercitatore" &&
    course.titolare.trim().toLowerCase() !== publicCv.basics.name.trim().toLowerCase(),
);
const localCourseEditionByKey = new Map(
  (await loadCourseManifests()).map((record) => [
    `${record.manifest.site.title}::${record.academicYear}`,
    record.href,
  ]),
);
const courseWebHref = (course: Course) => {
  const localHref = localCourseEditionByKey.get(
    `${course.courseName}::${course.aaInit}-${course.aaEnd}`,
  );

  return localHref ? withBasePath(localHref) : course.link;
};

const formatAcademicYearLong = (course: Course) =>
  course.aaInit === course.aaEnd
    ? `${course.aaInit}`
    : `${course.aaInit}/${course.aaEnd}`;
const courseCredits = (course: Course) => {
  const value = String(course.crediti ?? "").trim();
  return value && value.toUpperCase() !== "N" ? value : "-";
};
const courseLevel = (course: Course) => {
  const source = `${course.type ?? ""} ${course.level} ${course.short ?? ""}`.toLowerCase();
  const hasMs = /magistrale|specialistica|quinquennale|lm|master/.test(source);
  const hasPhd = /ph\.?d|dottor/.test(source);

  if (hasPhd && hasMs) return "PHD/MS";
  if (hasPhd) return "PHD";
  if (hasMs) return "MS";
  if (/primo livello|triennale|bachelor/.test(source)) return "BS";
  return "-";
};
const courseTrack = (course: Course) => {
  const source = `${course.level} ${course.short ?? ""}`.toLowerCase();

  if (/meccanica|energetica|mec|eng/.test(source)) return "MEC/ENG";
  if (/elettronica|biomedica|elett|bio/.test(source)) return "ELN/BIO";
  if (/informatica|ing\. inf/.test(source)) return "INF";
  if (/elettrica/.test(source)) return "ELN";
  if (/design/.test(source)) return "DES";
  return "-";
};

const courseSections = [
  {
    id: "lead",
    caption: "Table 1 - Courses as lead instructor",
    title: "Courses as lead instructor",
    courses: leadInstructorCourses,
  },
  {
    id: "assistant",
    caption: "Table 2 - Courses as teaching assistant",
    title: "Courses as teaching assistant",
    courses: teachingAssistantCourses,
  },
] as const;
---

<BaseLayout
  title="Courses"
  description="Current and past courses taught by Vittorio Zaccaria."
>
  <main class="page-shell">
    <section class="page-hero page-hero--compact">
      <p class="eyebrow">§ 2 · Teaching</p>
      <h1>Courses</h1>
      <p class="lede">
        Courses taught as lead instructor or teaching assistant, with links to
        active course webpages.
      </p>
    </section>

    <section class="content-band content-band--table courses-registry">
      {
        courseSections.map(({ id, caption, title, courses }) => (
          <div class="courses-registry__group">
            <div class="table-heading">
              <p>{caption}</p>
              <h2 class="visually-hidden">{title}</h2>
            </div>
            <div
              class={`registry-table registry-table--${id}`}
              role="table"
              aria-label={title}
            >
              <div class="registry-table__head" role="row">
                <span role="columnheader">AA</span>
                <span role="columnheader">Course</span>
                <span role="columnheader">{id === "assistant" ? "Hours" : "CR"}</span>
                <span role="columnheader">Level</span>
                <span role="columnheader">Track</span>
                <span role="columnheader">
                  {id === "assistant" ? "Lead instructor" : "Web"}
                </span>
              </div>
              {
                courses.map((course) => {
                  const webHref = id === "lead" ? courseWebHref(course) : undefined;

                  return (
                    <article class="registry-row" role="row">
                      <span role="cell">{formatAcademicYearLong(course)}</span>
                      <strong class="registry-row__course" role="cell">
                        {course.courseName}
                      </strong>
                      <span role="cell">
                        {id === "assistant" ? course.ore : courseCredits(course)}
                      </span>
                      <span role="cell">{courseLevel(course)}</span>
                      <span role="cell">{courseTrack(course)}</span>
                      <span role="cell">
                        {
                          id === "assistant" ? (
                            course.titolare
                          ) : webHref ? (
                            <a class="registry-row__web" href={webHref}>open</a>
                          ) : (
                            "-"
                          )
                        }
                      </span>
                    </article>
                  );
                })
              }
            </div>
          </div>
        ))
      }
    </section>
  </main>
</BaseLayout>
